[Unit]
Description=DTMS FastAPI OCR compression (Ghostscript)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/dtms/services/ocr
EnvironmentFile=-/etc/dtms-ocr.env
ExecStart=/var/www/dtms/services/ocr/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
