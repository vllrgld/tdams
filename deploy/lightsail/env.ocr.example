# Append to /var/www/dtms/.env on the instance. Do not replace the Laravel .env.
# Paste PADDLE_OCR_TOKEN and OLLAMA_API_KEY on the server only.

OCR_URL=http://127.0.0.1:8001
OCR_TOKEN=local-dev-token
OCR_TIMEOUT=300

PADDLE_OCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLE_OCR_TOKEN=
PADDLE_OCR_MODEL=PP-OCRv6

OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=180
